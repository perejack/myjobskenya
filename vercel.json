{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/hashback/(.*)",
      "destination": "https://api.hashback.co.ke/$1"
    },
    {
      "source": "/api/initiate-payment",
      "destination": "/api/initiate-payment.js"
    },
    {
      "source": "/api/payment-status",
      "destination": "/api/payment-status.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
